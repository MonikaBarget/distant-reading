{
  "jupyter-config-data": {
    "defaultMode": "classic",
    "theme": "JupyterLab Light",
    "kernelPreference": {
      "default": "pyodide"
    },
    "litePluginSettings": {
      "@jupyterlite/pyodide-kernel-extension:kernel": {
        "pyodideUrl": "https://cdn.jsdelivr.net/pyodide/v0.23.4/full/",
        "pipliteUrls": [
          "https://cdn.jsdelivr.net/pyodide/v0.23.4/full/pypi/"
        ]
      }
    }
  },
  "contents": "contents"
}